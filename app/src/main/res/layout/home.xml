<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.HomeFragment"
    android:background="@color/caribeean_green">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hey, Bon retour"
                            android:textSize="22sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/salutation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bonjour"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:alpha="0.9"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/icon_notify"
                        android:padding="8dp"
                        android:background="@drawable/menu_menu_border"
                        android:backgroundTint="@color/white"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Balance Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/menu_menu_border"
                        android:backgroundTint="@color/white"
                        android:padding="15dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Balance totale"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"/>

                        <TextView
                            android:id="@+id/total_income"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ar 0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/caribeean_green"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/menu_menu_border"
                        android:backgroundTint="@color/white"
                        android:padding="15dp"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dépense totale"
                            android:textSize="12sp"
                            android:textColor="@android:color/darker_gray"/>

                        <TextView
                            android:id="@+id/total_expense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ar 0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/ocean_blue"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Main Content Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/base_shape"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Saving Goal Card -->
                <LinearLayout
                    android:id="@+id/savingCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/caribain_border"
                    android:padding="20dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Objectif d'épargne"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <org.eazegraph.lib.charts.PieChart
                            android:id="@+id/piechart"
                            android:layout_width="120dp"
                            android:layout_height="120dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="20dp">

                            <TextView
                                android:id="@+id/savingTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vacances"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyprus"/>

                            <TextView
                                android:id="@+id/savingProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ar 500 000"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/caribeean_green"
                                android:layout_marginTop="5dp"/>

                            <TextView
                                android:id="@+id/savingGoal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Objectif: Ar 1 000 000"
                                android:textSize="12sp"
                                android:textColor="#404040"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick Stats -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Statistiques rapides"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="15dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/menu_menu_border"
                    android:padding="15dp">

                    <!-- Monthly Income -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/salary"
                            android:background="@drawable/menu_menu_border"
                            android:backgroundTint="@color/light_blue"
                            android:padding="8dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="15dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Revenus de ce mois"
                                android:textSize="14sp"
                                android:textColor="@android:color/darker_gray"/>

                            <TextView
                                android:id="@+id/textView11"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ar 0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/caribeean_green"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@android:color/darker_gray"
                        android:alpha="0.2"
                        android:layout_marginVertical="10dp"/>

                    <!-- Weekly Food Expense -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/food"
                            android:background="@drawable/menu_menu_border"
                            android:backgroundTint="@color/light_blue"
                            android:padding="8dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="15dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Repas (7 derniers jours)"
                                android:textSize="14sp"
                                android:textColor="@android:color/darker_gray"/>

                            <TextView
                                android:id="@+id/textView13"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="- Ar 0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/ocean_blue"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Tips Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/menu_menu_border"
                    android:backgroundTint="@color/light_blue"
                    android:padding="15dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="30sp"
                        android:layout_marginEnd="15dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Conseil du jour"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suivez vos dépenses quotidiennes pour mieux contrôler votre budget!"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:alpha="0.9"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
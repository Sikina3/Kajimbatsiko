<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.AnalyseFragment"
    android:background="@color/caribeean_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header fixe en haut -->
        <LinearLayout
            android:id="@+id/contenue_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="15dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/but_retour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/retour"
                    android:contentDescription="Retour" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ajouter un Revenu"
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/but_notif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_notify"
                    android:contentDescription="Notifications" />
            </LinearLayout>
        </LinearLayout>

        <!-- Zone Scrollable pour la responsivité -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contenue_principale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/base_shape"
                android:orientation="vertical"
                android:padding="25dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"/>

                <EditText
                    android:id="@+id/date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_menu_border"
                    android:hint="Sélectionne une date"
                    android:textColorHint="#545454"
                    android:textColor="?attr/colorOnSurface"
                    android:focusable="false"
                    android:clickable="true"
                    android:padding="12dp"
                    android:paddingStart="20dp"
                    android:textSize="14sp"
                    android:layout_marginTop="5dp"
                    android:inputType="none"/>

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Titre"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:layout_marginTop="15dp"/>

                <Spinner
                    android:id="@+id/titre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_menu_border"
                    android:padding="10dp"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:textColor="?attr/colorOnSurface"
                    android:text="Types"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/types"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_menu_border"
                    android:textSize="14sp"
                    android:hint="ex: Payement société B"
                    android:inputType="text"
                    android:padding="12dp"
                    android:paddingStart="20dp"
                    android:textColorHint="#545454"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:text="Montants"
                    android:textSize="16sp"
                    android:layout_marginTop="15dp"/>

                <EditText
                    android:id="@+id/montant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_menu_border"
                    android:textSize="14sp"
                    android:hint="ex: 1000000"
                    android:inputType="number"
                    android:padding="12dp"
                    android:paddingStart="20dp"
                    android:textColorHint="#545454"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:text="Note"
                    android:textSize="16sp"
                    android:layout_marginTop="15dp"/>

                <EditText
                    android:id="@+id/note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_menu_border"
                    android:textSize="14sp"
                    android:hint="Entrer une note"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:paddingStart="20dp"
                    android:textColorHint="#545454"
                    android:textColor="?attr/colorOnSurface"
                    android:minLines="3"
                    android:gravity="top"
                    android:layout_marginTop="5dp"/>

                <Button
                    android:id="@+id/but_send"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginHorizontal="20dp"
                    android:text="Enregistrer"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:backgroundTint="@color/caribeean_green"
                    android:paddingVertical="12dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

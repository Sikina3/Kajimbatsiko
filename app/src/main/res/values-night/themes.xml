<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Kajimbatsiko" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- Primary -->
        <item name="colorPrimary">@color/caribeean_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/fence_green</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        
        <!-- Surface & Background -->
        <item name="colorSurface">@color/vide</item>
        <item name="colorOnSurface">@color/honeydew</item>
        <item name="android:colorBackground">@color/vide</item>
        <item name="colorOnBackground">@color/honeydew</item>
        <item name="colorSurfaceInverse">@color/honeydew</item>
        <item name="colorOnSurfaceInverse">@color/vide</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/vide</item>

        <!-- Legacy attributes -->
        <item name="colorButtonNormal">@color/caribeean_green</item>
        <item name="colorAccent">@color/caribeean_green</item>
        <item name="colorPrimaryFixed">@color/caribeean_green</item>
        <item name="colorPrimarySurface">@color/vide</item>
        <item name="colorSecondary">@color/caribeean_green</item>
        <item name="colorTertiary">@color/caribeean_green</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>
</resources>
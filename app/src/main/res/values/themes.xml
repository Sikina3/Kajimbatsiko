<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Kajimbatsiko" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- Primary -->
        <item name="colorPrimary">@color/caribeean_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_green</item>
        <item name="colorOnPrimaryContainer">@color/cyprus</item>
        
        <!-- Surface & Background -->
        <item name="colorSurface">@color/honeydew</item>
        <item name="colorOnSurface">@color/cyprus</item>
        <item name="android:colorBackground">@color/honeydew</item>
        <item name="colorOnBackground">@color/cyprus</item>
        <item name="colorSurfaceInverse">@color/cyprus</item>
        <item name="colorOnSurfaceInverse">@color/fence_green</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/caribeean_green</item>

        <!-- Legacy attributes -->
        <item name="colorButtonNormal">@color/caribeean_green</item>
        <item name="colorAccent">@color/caribeean_green</item>
        <item name="colorPrimaryFixed">@color/caribeean_green</item>
        <item name="colorPrimarySurface">@color/caribeean_green</item>
        <item name="colorSecondary">@color/caribeean_green</item>
        <item name="colorTertiary">@color/light_blue</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="Theme.Kajimbatsiko" parent="Base.Theme.Kajimbatsiko" />

    <style name="CircleImageView" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>